menu "Motor node hardware"

config MOTOR_STEP_GPIO
    int "STEP GPIO"
    range 0 21
    default 0

config MOTOR_DIR_GPIO
    int "DIR GPIO"
    range 0 21
    default 1

config MOTOR_FULL_STEPS_PER_REV
    int "Motor full steps per revolution"
    range 1 100000
    default 200

config MOTOR_MICROSTEP
    int "Driver microstep divisor"
    range 1 256
    default 8

config MOTOR_DEFAULT_RPM
    int "Default motor RPM"
    range 1 1000
    default 100

config MOTOR_MAX_RPM
    int "Maximum motor RPM"
    range 1 1000
    default 150

config MOTOR_ACCELERATION
    int "Acceleration in pulses per second squared"
    range 1 1000000
    default 1000

config MOTOR_DIRECTION_INVERTED
    bool "Invert electrical motor direction"
    default n

config MOTOR_FULL_TRAVEL_STEPS
    int "Pulses from fully closed to fully open"
    range 1 2147483647
    default 36000
    help
        Replace the default with the measured pulse count after installing the
        actuator. This is not the motor's steps-per-revolution value.

config MOTOR_VENTILATION_POSITION_100THS
    int "Ventilation position in 0.01 percent units"
    range 0 10000
    default 2500

config MOTOR_FEEDBACK_STALE_MS
    int "Position feedback timeout in milliseconds"
    range 100 10000
    default 2000

config MOTOR_FEEDBACK_PERIOD_MS
    int "Position feedback period in milliseconds"
    range 5 500
    default 20
endmenu
